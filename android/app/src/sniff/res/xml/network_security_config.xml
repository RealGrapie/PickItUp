<?xml version="1.0" encoding="utf-8"?>
<!-- Sniff builds only: trust user CAs too, so a proxy (Reqable) can decrypt Ozon's traffic. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
